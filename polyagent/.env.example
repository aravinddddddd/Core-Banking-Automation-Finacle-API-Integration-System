# Copy to .env and fill in only the providers you actually use.
# .env is gitignored — never commit a real key.

# Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# OpenAI-compatible services
OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Local Ollama needs no key; override only for a non-default host.
# OLLAMA_HOST=http://localhost:11434
